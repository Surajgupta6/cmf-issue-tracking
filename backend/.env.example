# Copy this file to .env and fill in your values
# cp .env.example .env

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cmf_issue_tracker

JWT_SECRET=replace-with-a-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Set to "true" to disable background cron jobs (useful in test environments)
DISABLE_JOBS=false
