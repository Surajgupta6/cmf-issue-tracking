PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/cmf_issue_tracker

# JWT access token secret — use a strong random value in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Comma-separated list of allowed CORS origins (defaults to localhost:5173,localhost:3000)
# In production: set to your deployed frontend URL, e.g. https://cmf-tracker.example.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Redis URL (required when Phase 11 Redis integration is added)
# REDIS_URL=redis://localhost:6379